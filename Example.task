var BuildDir = build
var Greeting = Hello from the example task

script Setup
    folder {BuildDir}
    switch {BuildDir}
    file notes.txt
        {Greeting}
    append notes.txt
        This line was appended separately.
    read notes.txt
    rename notes.txt README.txt
    folder "staging area"
    copy README.txt "staging area/README.txt"
    move README.txt "staging area/README (moved).txt"
    folder scratch
    file scratch/temp.txt
        Temporary content, about to be cleaned.
    clean scratch
    delete scratch

script Build
    folder {BuildDir}
    switch {BuildDir}
    run echo "Building in $(pwd)"
    wait 1
    run
        echo "Step 1"
        echo "Step 2"
        echo "Step 3"
    . Build finished.

script Package
    after Build
    after Setup
    . Packaging what Build and Setup already produced.
