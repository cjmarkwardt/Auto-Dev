<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoDev.ViewModels.Dialogs"
        x:Class="AutoDev.Views.Dialogs.InputDialogWindow"
        x:DataType="vm:InputDialogViewModel"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Background="{DynamicResource EditorBackgroundBrush}">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBox Text="{Binding Value}" Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding !RequireValue}" />
            <Button Content="OK" Classes="accent" Command="{Binding OkCommand}" IsDefault="True" IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </StackPanel>
</Window>
