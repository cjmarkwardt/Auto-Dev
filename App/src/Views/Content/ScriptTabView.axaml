<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoDev.ViewModels.Content"
             x:Class="AutoDev.Views.Content.ScriptTabView"
             x:DataType="vm:ScriptTabViewModel">
    <UserControl.Styles>
        <!-- One sub-tab per script in the currently-selected task (see the ItemsControl below) - a plain
             Button per AGENTS.md's "prefer a dedicated RelayCommand over a control's own built-in selection"
             rule, with IsSelected (set explicitly by ScriptTabViewModel, not inferred from a control's own
             SelectedItem) driving which one currently reads as active. -->
        <Style Selector="Button.scriptSubTab">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.scriptSubTab.active">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="10,6" IsVisible="{Binding HasEntries}">
            <ComboBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" PlaceholderText="Select a script…">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:ScriptEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="●" FontSize="8" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding IsRunning}" />
                            <!-- Id is the workspace-relative path (see ScriptEntry) - shown here in full,
                                 rather than Name (just the filename), so two same-named scripts in different
                                 folders read as distinct entries. -->
                            <TextBlock Grid.Column="1" Text="{Binding Id}" FontSize="12" VerticalAlignment="Center" />
                            <!-- Hidden (not just disabled) while running - RemoveEntryCommand refuses a
                                 running entry anyway (see ScriptTabViewModel.CanRemoveEntry), but stopping it
                                 first is the point: an in-flight run has nowhere else to be viewed/stopped
                                 from once its entry is gone. -->
                            <Button Grid.Column="2" Classes="iconButton" ToolTip.Tip="Remove"
                                    Margin="6,0,0,0" IsVisible="{Binding !IsRunning}"
                                    Command="{Binding $parent[UserControl].((vm:ScriptTabViewModel)DataContext).RemoveEntryCommand}"
                                    CommandParameter="{Binding}">
                                <Path Classes="lineIcon" Data="{StaticResource CloseIconGeometry}" Width="9" Height="9" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Border>

        <!-- Only shown while the selected dropdown entry is a task (see ScriptEntry.IsTask/Children) - one
             sub-tab per script it runs, letting each be viewed independently while Stop (below) still applies
             to the whole task regardless of which one is currently showing. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="6,4" IsVisible="{Binding SelectedEntry.IsTask}">
            <ItemsControl ItemsSource="{Binding SelectedEntry.Children}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ScriptEntry">
                        <Button Classes="scriptSubTab" Classes.active="{Binding IsSelected}"
                                Command="{Binding $parent[UserControl].((vm:ScriptTabViewModel)DataContext).SelectChildTabCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" Padding="10,4"
                IsVisible="{Binding HasScript}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScriptName}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowRunning}">
                        <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Running…" FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="✓ Succeeded" IsVisible="{Binding ShowSucceeded}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="⊘ Stopped" IsVisible="{Binding ShowStopped}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="✗ Failed" IsVisible="{Binding ShowFailed}" FontSize="11" Foreground="Crimson" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <!-- Always available regardless of whatever text selection (if any) the output area
                         below currently has - see ScriptTabViewModel.CanCopyOutput's own doc comment for why
                         that can't always be trusted on its own. -->
                    <Button Classes="iconButton" ToolTip.Tip="Copy Output" Command="{Binding CopyOutputCommand}">
                        <Path Classes="lineIcon" Data="{StaticResource CopyIconGeometry}" Width="13" Height="13" />
                    </Button>
                    <!-- Bound to SelectedEntry.IsRunning (not ShowRunning, which tracks only the currently
                         displayed sub-tab) so Stop stays visible for a whole task while it's still in
                         progress even if the specific script currently being viewed has already finished -
                         see ScriptTabViewModel.CanStop's own doc comment. -->
                    <Button Classes="sidebarAction" Content="Stop" Command="{Binding StopCommand}"
                            IsVisible="{Binding SelectedEntry.IsRunning}" ToolTip.Tip="Forcefully stop this script" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Only shown while the viewed script is actually running - lets it receive a line of text on its
             own stdin (e.g. a Console.ReadLine() call it's currently blocked on), which would otherwise hang
             forever since nothing else in AutoDev ever supplies it input. See ScriptTabViewModel.
             SendInputAsync/LiveScriptRun.SendInputAsync. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="10,6"
                IsVisible="{Binding ShowRunning}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Name="InputBox" Text="{Binding InputText}"
                         PlaceholderText="Enter input for the running script… (Enter to send)" />
                <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Command="{Binding SendInputCommand}" />
            </Grid>
        </Border>

        <!-- A DockPanel only gives HorizontalAlignment/VerticalAlignment room to work with on its LAST
             child (LastChildFill) - these two are mutually-exclusive alternates for the same body area, so
             they're grouped in their own Grid where every child gets the full remaining space to center in. -->
        <Grid>
            <TextBlock Text="No script selected. Pick one from the dropdown above, or right-click a .cs or .task file in the sidebar and choose View."
                       IsVisible="{Binding !HasScript}" TextWrapping="Wrap" TextAlignment="Center" Margin="24,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />

            <ScrollViewer IsVisible="{Binding HasScript}" Name="Scroller">
                <SelectableTextBlock Text="{Binding OutputText}" TextWrapping="Wrap" Margin="14,10,14,14"
                                      FontFamily="Cascadia Code,Consolas,DejaVu Sans Mono,Liberation Mono,monospace" FontSize="12" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
