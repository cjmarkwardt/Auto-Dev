<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Simple monochrome line-icon geometries (VS-Code-ish flat outline style) rather than colorful emoji. -->
    <Geometry x:Key="FileIconGeometry">M4,1 L10,1 L13,4 L13,15 L4,15 Z M10,1 L10,4 L13,4</Geometry>
    <!-- FileIconGeometry's dog-eared-corner shape plus a small play triangle - marks a .task file in the
         Files section's tree (see FileTreeNodeViewModel.IsTaskFile) as runnable, in place of the plain file
         icon every other file gets. -->
    <Geometry x:Key="TaskFileIconGeometry">M4,1 L10,1 L13,4 L13,15 L4,15 Z M10,1 L10,4 L13,4 M6.5,7.5 L6.5,11.5 L10,9.5 Z</Geometry>
    <!-- Bounding box deliberately pinned to a 12x12 square (matching this icon's own Path Width/Height in
         FilesSectionView.axaml's tree rows) so Stretch="Uniform" doesn't distort it - the original shape's
         bounding box was 14 wide x 9 tall, rendering visibly shorter than FileIconGeometry's own box-filling
         14-tall shape next to it in the same row. -->
    <Geometry x:Key="FolderIconGeometry">M1,3 L5,3 L6.3,4.5 L13,4.5 L13,15 L1,15 Z</Geometry>
    <!-- FileIconGeometry's dog-eared-corner shape plus a small "+" - stands in for the Files section's "New File" icon button. -->
    <Geometry x:Key="NewFileIconGeometry">M2,1 L7,1 L10,4 L10,13 L2,13 Z M7,1 L7,4 L10,4 M12,7 L12,11 M10,9 L14,9</Geometry>
    <!-- FolderIconGeometry's shape (shrunk to leave room for the badge) plus a small "+" - stands in for the
         Files section's "New Folder" icon button. The "+" sits within the folder's own bottom-right corner
         (not floating off to the side) so the combined bounding box stays a perfect square, same reasoning as
         FolderIconGeometry's own doc comment. -->
    <Geometry x:Key="NewFolderIconGeometry">M1,3 L5,3 L6.3,4.5 L11,4.5 L11,11 L1,11 Z M9,9 L9,13 M7,11 L11,11</Geometry>
    <!-- An arrow breaking out of a box - stands in for "open in the OS file manager" (Files section's "Open"). -->
    <Geometry x:Key="OpenExternalIconGeometry">M5,1 L12,1 L12,8 M12,1 L6,7 M9,4 L2,4 L2,12 L10,12 L10,7</Geometry>
    <!-- Two chevrons pointing inward/up (VS-Code-style "collapse all") - stands in for the Files section's "Collapse All" icon button. -->
    <Geometry x:Key="CollapseAllIconGeometry">M2,6 L7,1 L12,6 M2,13 L7,8 L12,13</Geometry>
    <!-- An open eye (almond outline + pupil) - stands in for the Files section's "Show/Hide Ignored Files"
         toggle button (see FilesSectionViewModel.ShowIgnoredFiles); the shared iconButton.active style (not a
         second geometry) is what distinguishes the two states. -->
    <Geometry x:Key="EyeIconGeometry">M1,7 Q7,1 13,7 Q7,13 1,7 Z M7,4.5 A2.5,2.5 0 1,1 6.999,4.5 Z</Geometry>
    <!-- Three uneven diffstat-style bars (like a compact "N changed files" summary) - stands in for the Files
         section's "Changes Mode" toggle button (see FilesSectionViewModel.IsChangesMode). -->
    <Geometry x:Key="ChangesIconGeometry">M2,3 L8,3 M2,7 L12,7 M2,11 L6,11</Geometry>
    <Geometry x:Key="HomeIconGeometry">M3,9 L12,2 L21,9 L21,20 A2,2 0 0,1 19,22 L5,22 A2,2 0 0,1 3,20 Z M9,22 L9,12 L15,12 L15,22</Geometry>
    <Geometry x:Key="PlayIconGeometry">M3,2 L13,8 L3,14 Z</Geometry>
    <!-- The two bare M points (no drawn segment) pin the bounding box to the same 1,1-13,13 square the other
         window-control icons use, so Stretch="Uniform" scales this one identically instead of over-zooming a
         thin bar's own tiny bounding box - without them the bar renders far too large and drifts toward the
         top of the icon instead of sitting at the bottom like a normal minimize glyph. -->
    <Geometry x:Key="MinimizeIconGeometry">M1,1 M13,13 M1,10.6 L13,10.6 L13,12 L1,12 Z</Geometry>
    <Geometry x:Key="MaximizeIconGeometry">M1,1 L13,1 L13,13 L1,13 Z</Geometry>
    <Geometry x:Key="RestoreIconGeometry">M4,1 L13,1 L13,10 L10,10 M1,4 L10,4 L10,13 L1,13 Z</Geometry>
    <Geometry x:Key="CloseIconGeometry">M1,1 L13,13 M13,1 L1,13</Geometry>
    <Geometry x:Key="ChevronDownIconGeometry">M2,4 L7,9 L12,4</Geometry>
    <!-- A simple "download into local folder" glyph, standing in for "clone a remote repository". -->
    <Geometry x:Key="CloneIconGeometry">M7,1 L7,9 M3,5 L7,9 L11,5 M1,12 L13,12</Geometry>
    <!-- A gear, simplified to an octagon (the "teeth") with a small circular hole in the middle - stands in for "settings/configure". -->
    <Geometry x:Key="GearIconGeometry">M13,7 L11.24,11.24 L7,13 L2.76,11.24 L1,7 L2.76,2.76 L7,1 L11.24,2.76 Z M9.5,7 A2.5,2.5 0 1,1 9.499,6.99 Z</Geometry>
    <!-- A pencil (shaft + tip) - stands in for the Edit Tab's markdown edit toggle. -->
    <Geometry x:Key="EditIconGeometry">M2,13 L1,10.5 L8.5,3 L11,5.5 L3.5,13 Z M8.5,3 L10.5,1 L13,3.5 L11,5.5 Z</Geometry>
    <!-- A magnifying glass (near-full circle, drawn as a single almost-360-degree arc like GearIconGeometry's
         own center hole, plus a handle) - stands in for the Edit Tab's Find-in-file toggle. -->
    <Geometry x:Key="FindIconGeometry">M9,5 A4,4 0 1,1 8.999,5 Z M7.83,7.83 L13,13</Geometry>
</ResourceDictionary>
