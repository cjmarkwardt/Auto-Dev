<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoDev.Views.WindowControlsView">
    <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="iconButton" ToolTip.Tip="Minimize" Click="OnMinimizeClick">
            <Path Classes="lineIcon" Data="{StaticResource MinimizeIconGeometry}" Width="11" Height="11"
                  Fill="{DynamicResource TextMutedBrush}" Stroke="Transparent" />
        </Button>
        <Button Name="MaximizeButton" Classes="iconButton" ToolTip.Tip="Maximize" Click="OnMaximizeRestoreClick">
            <Path Classes="lineIcon" Data="{StaticResource MaximizeIconGeometry}" Width="11" Height="11" />
        </Button>
        <Button Name="RestoreButton" Classes="iconButton" ToolTip.Tip="Restore" Click="OnMaximizeRestoreClick" IsVisible="False">
            <Path Classes="lineIcon" Data="{StaticResource RestoreIconGeometry}" Width="11" Height="11" />
        </Button>
        <Button Classes="iconButton" ToolTip.Tip="Close" Click="OnCloseClick">
            <Path Classes="lineIcon" Data="{StaticResource CloseIconGeometry}" Width="11" Height="11" />
        </Button>
    </StackPanel>
</UserControl>
