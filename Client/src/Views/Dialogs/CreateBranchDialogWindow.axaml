<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoDev.ViewModels.Dialogs"
        x:Class="AutoDev.Views.Dialogs.CreateBranchDialogWindow"
        x:DataType="vm:CreateBranchDialogViewModel"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Create Branch"
        Background="{DynamicResource EditorBackgroundBrush}">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Name" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBox Text="{Binding Name}" Name="NameBox" />

        <TextBlock Text="Id" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
        <TextBox Text="{Binding Id}" Name="IdBox" />

        <CheckBox Content="Public" IsChecked="{Binding IsPublic}" Margin="0,6,0,0"
                   ToolTip.Tip="For collaboration between many users - keeps this branch's full commit log forever instead of squashing it, and disables Squash and Rename. Leave unchecked for a private, one-user branch meant to be squashed and merged/deleted." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Create" Classes="accent" Command="{Binding OkCommand}" IsDefault="True" IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </StackPanel>
</Window>
