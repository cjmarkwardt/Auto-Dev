<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoDev.ViewModels.Dialogs"
        x:Class="AutoDev.Views.Dialogs.CreateTagDialogWindow"
        x:DataType="vm:CreateTagDialogViewModel"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Create Tag"
        Background="{DynamicResource EditorBackgroundBrush}">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Full Name" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBox Text="{Binding FullName}" Name="FullNameBox" />

        <TextBlock Text="Id" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
        <TextBox Text="{Binding Id}" Name="IdBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Create" Classes="accent" Command="{Binding OkCommand}" IsDefault="True" IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </StackPanel>
</Window>
