<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AutoDev.ViewModels"
             xmlns:aicli="using:AutoDev.AiCli"
             xmlns:models="using:AutoDev.Core.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:views="using:AutoDev.Views"
             x:Class="AutoDev.Views.MainShellView"
             x:DataType="vm:MainShellViewModel">
    <UserControl.Styles>
        <Style Selector="Border.recentRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.recentRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        </Style>
    </UserControl.Styles>
    <Panel>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}" Height="52"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Name="TitleBar" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,0">

                <!-- Workspace launcher -->
                <StackPanel Grid.Column="0" DataContext="{Binding Header}" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="iconButton" ToolTip.Tip="Open Folder…" Command="{Binding BrowseForFolderCommand}" IsEnabled="{Binding !IsCloning}">
                        <Path Classes="lineIcon" Data="{StaticResource FolderIconGeometry}" Width="13" Height="13" />
                    </Button>
                    <Button Classes="iconButton" ToolTip.Tip="Clone Repository…" Command="{Binding CloneCommand}" IsVisible="{Binding !IsCloning}">
                        <Path Classes="lineIcon" Data="{StaticResource CloneIconGeometry}" Width="13" Height="13" />
                    </Button>
                    <Button Classes="iconButton" ToolTip.Tip="Cancel Clone" Command="{Binding CancelCloneCommand}" IsVisible="{Binding IsCloning}">
                        <Path Classes="lineIcon" Data="{StaticResource CloseIconGeometry}" Width="11" Height="11" />
                    </Button>
                    <TextBlock Text="Cloning…" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="4,0,4,0" IsVisible="{Binding IsCloning}" />
                    <Button Classes="iconButton" ToolTip.Tip="Open Recent…" Command="{Binding ToggleRecentMenuCommand}" IsEnabled="{Binding !IsCloning}">
                        <Path Classes="lineIcon" Data="{StaticResource ChevronDownIconGeometry}" Width="10" Height="8" />
                    </Button>
                </StackPanel>

                <!-- Open workspace tabs -->
                <ListBox Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" Padding="0" BorderThickness="0" Margin="20,0,0,0"
                         VerticalAlignment="Stretch" IsVisible="{Binding SelectedTab, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceTabViewModel">
                            <Border Padding="14,0" ToolTip.Tip="{Binding TooltipPath}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Background="Transparent">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Move Left" Command="{Binding MoveLeftCommand}" />
                                        <MenuItem Header="Move Right" Command="{Binding MoveRightCommand}" />
                                        <Separator />
                                        <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                             IsVisible="{Binding Version.IsAiWorking}" ToolTip.Tip="AI is working" />
                                    <TextBlock Classes="tabTitle" Classes.aiWorking="{Binding Version.IsAiWorking}"
                                               Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Account / usage - click to switch the active AI provider (see Header.AvailableProviders'
                     own dropdown below); what's shown here depends on that provider (Session/Week percentages
                     for Claude, a plain cumulative token count for a provider with no usage-percentage API -
                     see Header.HasPeriodUsage). -->
                <Button Grid.Column="2" Classes="iconButton" Margin="20,0,0,0" Padding="8,4"
                        Command="{Binding Header.ToggleProviderMenuCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                                    IsVisible="{Binding Header.HasPeriodUsage}">
                            <StackPanel Spacing="0" VerticalAlignment="Center" ToolTip.Tip="{Binding Header.SessionResetTooltip}">
                                <TextBlock Classes="usageText" Classes.critical="{Binding Header.IsSessionUsageCritical}"
                                           Text="{Binding Header.SessionUsageDisplay}" HorizontalAlignment="Right" FontSize="12" />
                                <TextBlock Text="{Binding Header.SessionResetCountdown}" HorizontalAlignment="Right"
                                           IsVisible="{Binding Header.SessionResetCountdown, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Spacing="0" VerticalAlignment="Center" ToolTip.Tip="{Binding Header.WeekResetTooltip}">
                                <TextBlock Classes="usageText" Classes.critical="{Binding Header.IsWeekUsageCritical}"
                                           Text="{Binding Header.WeekUsageDisplay}" HorizontalAlignment="Right" FontSize="12" />
                                <TextBlock Text="{Binding Header.WeekResetCountdown}" HorizontalAlignment="Right"
                                           IsVisible="{Binding Header.WeekResetCountdown, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Header.TokenUsageDisplay}" FontSize="12" VerticalAlignment="Center"
                                   ToolTip.Tip="Cumulative token usage this app session (all AI activity) - this provider has no usage-limit percentage available."
                                   IsVisible="{Binding !Header.HasPeriodUsage}" />

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <TextBlock Text="{Binding Header.ProviderDisplayName}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Path Classes="lineIcon" Data="{StaticResource ChevronDownIconGeometry}" Width="9" Height="7" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Header.AccountEmail}" FontSize="12" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="5,1"
                                    IsVisible="{Binding Header.SubscriptionType, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Header.SubscriptionType}" FontSize="10" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <views:WindowControlsView Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- AI status bar - reflects the selected tab's own Version.IsAiWorking, the same flag that locks
             Tasks/Edit/History/Version-menu controls, so this bar's color always matches whether the
             controls are actually locked right now. It also reflects Files.HasRunningTasks the same way (same
             accent-colored "working" look) - a running task doesn't lock those same controls the way
             IsAiWorking does, but it does block a new Claude turn from starting (see GenerateTabViewModel.
             CanSend), so this still needs to surface as a reason "the workspace can't be changed" right now.
             IsAiWorking's own text always wins when both are somehow true at once (e.g. a task started
             mid-turn), since it's the more disruptive state - the bar still just shows accent-colored either
             way. Must come before the main content Grid below: a DockPanel's LAST child always fills remaining
             space regardless of its own Dock value (LastChildFill), so the Grid - not this bar - needs to stay
             last. -->
        <Border DockPanel.Dock="Bottom" Height="26" Padding="12,0"
                Classes="aiStatusBar"
                Classes.working="{Binding SelectedTab.Version.IsAiWorking}"
                Classes.taskRunning="{Binding SelectedTab.Files.HasRunningTasks}"
                IsVisible="{Binding SelectedTab, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <!-- Background is set entirely via these styles, not a local attribute on the Border - a local
                 value always wins over a style setter regardless of class, which would otherwise permanently
                 shadow the "working"/"taskRunning" state below no matter what class was actually applied.
                 Two independent selectors (rather than one combined-condition class) both map to the same
                 accent color, since Classes.<name>="{Binding ...}" only accepts a single simple boolean
                 binding, not a MultiBinding OR of the two source properties. -->
            <Border.Styles>
                <Style Selector="Border.aiStatusBar">
                    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
                </Style>
                <Style Selector="Border.aiStatusBar.working">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </Style>
                <Style Selector="Border.aiStatusBar.taskRunning">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </Style>
            </Border.Styles>
            <Grid>
                <TextBlock Text="AI is waiting…" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                            <Binding Path="!SelectedTab.Version.IsAiWorking" />
                            <Binding Path="!SelectedTab.Files.HasRunningTasks" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Text="Task is running…" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="White">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                            <Binding Path="!SelectedTab.Version.IsAiWorking" />
                            <Binding Path="SelectedTab.Files.HasRunningTasks" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Text="AI work in progress…" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="White">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                            <Binding Path="SelectedTab.Version.IsAiWorking" />
                            <Binding Path="!SelectedTab.Version.IsAiPaused" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <!-- Same accent-colored "locked" look as "AI work in progress…" (see Classes.working above,
                     bound to IsAiWorking alone - deliberately not reset while paused) with different text,
                     for a paused Generate turn (GenerateTabViewModel.PauseAsync) - see
                     VersionSectionViewModel.IsAiPaused. -->
                <TextBlock Text="AI is paused" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="White" IsVisible="{Binding SelectedTab.Version.IsAiPaused}" />
            </Grid>
        </Border>

        <Grid>
            <ContentControl Content="{Binding SelectedTab}" />
            <StackPanel IsVisible="{Binding SelectedTab, Converter={x:Static conv:ObjectConverters.IsNull}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="No workspace open" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="Use the folder icon in the top bar to get started." FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>

        <!-- Recent-workspaces dropdown - a plain in-tree overlay (not a native Flyout/Popup) to match the
             F2 quick-open overlay's own established pattern in this codebase. -->
        <Panel IsVisible="{Binding Header.IsRecentMenuOpen}" Background="Transparent" PointerPressed="OnRecentBackdropPointerPressed">
            <Border Width="340" MaxHeight="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,56,0,0"
                    Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="6" PointerPressed="OnRecentPopupPointerPressed">
                <StackPanel>
                    <TextBlock Text="No recent workspaces" Margin="12,10" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding !Header.RecentWorkspaces.Count}" />
                    <ScrollViewer MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding Header.RecentWorkspaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:WorkspaceInfo">
                                    <Border Classes="recentRow" Padding="12,8" PointerPressed="OnRecentRowPointerPressed">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FullPath}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="iconButton" ToolTip.Tip="Remove from recent"
                                                    Command="{Binding $parent[UserControl].((vm:MainShellViewModel)DataContext).Header.RemoveRecentCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="lineIcon" Data="{StaticResource CloseIconGeometry}" Width="9" Height="9" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Panel>

        <!-- AI provider switcher dropdown - same plain in-tree overlay pattern as the recent-workspaces one above. -->
        <Panel IsVisible="{Binding Header.IsProviderMenuOpen}" Background="Transparent" PointerPressed="OnProviderBackdropPointerPressed">
            <Border Width="160" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,20,0"
                    Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="6" PointerPressed="OnProviderPopupPointerPressed">
                <ItemsControl ItemsSource="{Binding Header.AvailableProviders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="aicli:AiProvider">
                            <Border Classes="recentRow" Padding="12,8" PointerPressed="OnProviderRowPointerPressed" Tag="{Binding}">
                                <TextBlock Text="{Binding}" FontSize="12.5" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Panel>
    </Panel>
</UserControl>
